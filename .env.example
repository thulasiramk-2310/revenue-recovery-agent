# Razorpay TEST MODE credentials only. Never put live keys here.
# Copy to .env and fill in:  cp .env.example .env
# Get keys: Razorpay Dashboard -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Safety rail: the executor refuses to run unless this is exactly "test".
RAZORPAY_MODE=test

# Optional. Used only for LLM diagnosis of unmapped gateway failure codes.
# The offline AI demo does not need this; `python -m src.run_ai_demo --live-llm`
# does. Never commit a real key.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Optional fallback if policy.yaml uses `provider: anthropic`.
# ANTHROPIC_API_KEY=sk-ant-api03_xxxxxxxxxxxxxxxxxxxx
